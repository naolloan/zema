{
  "expo": {
    "name": "Zeማa",
    "slug": "zema-mobile",
    "scheme": "zema",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naolloan.zema"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f141c"
      },
      "package": "com.naolloan.zema"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
