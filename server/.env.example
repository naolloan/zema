# Database
DATABASE_URL="postgresql://username:password@localhost:5432/music_platform"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Optional external integrations
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
SPOTIFY_OAUTH_REDIRECT_URI="http://127.0.0.1:5000/api/auth/spotify/callback"
SPOTIFY_OAUTH_SCOPES="user-read-email user-read-private"
SPOTIFY_FORCE_IPV4="false"
SPOTIFY_REQUEST_TIMEOUT_MS="20000"
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Zeማa <auth@yourdomain.com>"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# Server
NODE_ENV="development"
PORT=5000
PUBLIC_API_BASE_URL="http://localhost:5000"
TRUST_PROXY="1"

# CORS
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Auth cookies
AUTH_COOKIE_NAME="zema_session"
AUTH_COOKIE_DOMAIN=""
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"

# Rate limits
AUTH_RATE_LIMIT_MAX=25
WRITE_RATE_LIMIT_MAX=120
